{
  "capabilities": [
    "simple_interface",
    "model_loading",
    "inference",
    "inspection",
    "chat_templates",
    "prompt_queue",
    "terminal_events",
    "agents_optional"
  ],
  "commands": [
    "python -m arclm --run simple-interface"
  ],
  "description": "A standalone local Flask chat interface with model loading, inspection, streaming events, prompt queue and optional safe Agent integration.",
  "documentation": [
    "README.md",
    "docs/distributions.md",
    "docs/special-version.md"
  ],
  "examples": [
    "examples/distributions/simple_interface_example.py"
  ],
  "excluded_apis": [
    "arclm.web",
    "arclm.training",
    "arclm.finetuning",
    "arclm.peft"
  ],
  "excluded_module_prefixes": [
    "arclm.web",
    "arclm.training.trainer",
    "arclm.training.unified",
    "arclm.finetuning",
    "arclm.peft",
    "arclm.search"
  ],
  "id": "simple-interface",
  "include_assets": [
    "arclm/templates",
    "arclm/py.typed"
  ],
  "include_module_prefixes": [],
  "include_modules": [
    "arclm._version",
    "arclm.simple_interface",
    "arclm.simple_chat",
    "arclm.inference",
    "arclm.models",
    "arclm.checkpoints",
    "arclm.tokenizers",
    "arclm.configs",
    "arclm.exceptions",
    "arclm.inspection",
    "arclm.lifecycle",
    "arclm.agents",
    "arclm.security.redaction",
    "arclm.security.paths",
    "arclm.security.network",
    "arclm.utils"
  ],
  "license": "Apache-2.0",
  "name": "ArcLM Simple Interface",
  "optional_dependencies": {
    "hf": [
      "transformers>=4.51,<6",
      "accelerate>=0.30,<2",
      "safetensors>=0.4,<1"
    ]
  },
  "public_api": [
    "arclm.simple_interface.create_simple_interface_app",
    "arclm.simple_interface.run_simple_interface",
    "arclm.simple_chat",
    "arclm.inference"
  ],
  "python_dependencies": [
    "torch>=2.1,<3",
    "numpy>=1.24,<3",
    "sentencepiece>=0.2,<0.3",
    "flask>=3,<4"
  ],
  "required_distributions": [
    "core",
    "loading-inference",
    "agents-tools"
  ],
  "schema_version": 1,
  "source_package": "src/arclm",
  "tests": [
    "tests/web/test_simple_chat_api.py",
    "tests/web/test_simple_interface_frontend.py"
  ]
}