    "python -c \"from arclm.evaluation import EvaluationResult; print(EvaluationResult)\""
  ],
  "description": "Evaluation metrics, reports, checkpoint comparison and local benchmark helpers.",
  "documentation": [
    "README.md",
    "docs/distributions.md"
  ],
  "examples": [
    "examples/distributions/evaluation_benchmarks_example.py"
  ],
  "excluded_apis": [
    "arclm.simple_interface",
    "arclm.web",
    "arclm.agents"
  ],
  "excluded_module_prefixes": [
    "arclm.web",
    "arclm.simple_interface",
    "arclm.simple_chat",
    "arclm.training.trainer",
    "arclm.agents",
    "arclm.security.web"
  ],
  "id": "evaluation-benchmarks",
  "include_assets": [
    "arclm/py.typed"
  ],
  "include_module_prefixes": [],
  "include_modules": [
    "arclm._version",
    "arclm.evaluation",
    "arclm.models",
    "arclm.inference",
    "arclm.checkpoints",
    "arclm.datasets",
    "arclm.tokenizers",
    "arclm.configs",
    "arclm.exceptions",
    "arclm.utils"
  ],
  "license": "Apache-2.0",
  "name": "ArcLM Evaluation and Benchmarks",
  "optional_dependencies": {},
  "public_api": [
    "arclm.evaluation"
  ],
  "python_dependencies": [
    "torch>=2.1,<3",
    "numpy>=1.24,<3",
    "sentencepiece>=0.2,<0.3"
  ],
  "required_distributions": [
    "core",
    "loading-inference",
    "data-tokenizers"
  ],
  "schema_version": 1,
  "source_package": "src/arclm",
  "tests": [
    "tests/unit/evaluation"
  ]
