{
  "schema_version": 1,
  "id": "finetuning",
  "name": "ArcLM Fine-tuning Block",
  "description": "Supervised fine-tuning (SFT) workflows, full fine-tuners, adapters and native training support. Requires PyTorch.",
  "source_package": "src/arclm",
  "capabilities": ["finetuning", "sft", "adapters", "training", "models", "checkpoints"],
  "include_modules": [
    "arclm._version",
    "arclm.finetuning",
    "arclm.training",
    "arclm.models",
    "arclm.datasets",
    "arclm.tokenizers",
    "arclm.checkpoints",
    "arclm.configs",
    "arclm.lifecycle",
    "arclm.exceptions",
    "arclm.utils",
    "arclm.registry"
  ],
  "include_module_prefixes": [],
  "include_assets": ["arclm/py.typed"],
  "required_distributions": [],
  "excluded_module_prefixes": [
    "arclm.web",
    "arclm.evaluation",
    "arclm.inference",
    "arclm.agents",
    "arclm.security",
    "arclm.peft",
    "arclm.search"
  ],
  "python_dependencies": ["torch>=2.1,<3", "numpy>=1.24,<3", "sentencepiece>=0.2,<0.3"],
  "optional_dependencies": {
    "peft": ["peft>=0.11,<1"]
  },
  "public_api": ["arclm.finetuning", "arclm.training", "arclm.models"],
  "excluded_apis": ["arclm.web", "arclm.evaluation", "arclm.inference"],
  "commands": [
    "python -c \"from arclm.finetuning import FineTuningConfig, train_sft; print(FineTuningConfig)\""
  ],
  "tests": ["tests/unit/finetuning"],
  "examples": ["examples/05_finetuning/01_preview_sft_data.py"],
  "documentation": ["README.md", "docs/distributions.md"],
  "license": "Apache-2.0"
}
