{
  "schema_version": 1,
  "id": "training",
  "name": "ArcLM Training Block",
  "description": "Native training loop, ArcLM models, checkpoints, evaluation metrics and experiment tracking. Requires PyTorch.",
  "source_package": "src/arclm",
  "capabilities": ["training", "models", "checkpoints", "tracking", "distributed_contracts"],
  "include_modules": [
    "arclm._version",
    "arclm.training",
    "arclm.models",
    "arclm.datasets",
    "arclm.tokenizers",
    "arclm.checkpoints",
    "arclm.configs",
    "arclm.lifecycle",
    "arclm.exceptions",
    "arclm.utils",
    "arclm.registry",
    "arclm.distributed",
    "arclm.tracking"
  ],
  "include_module_prefixes": [],
  "include_assets": ["arclm/py.typed"],
  "required_distributions": [],
  "excluded_module_prefixes": [
    "arclm.web",
    "arclm.finetuning",
    "arclm.evaluation",
    "arclm.inference",
    "arclm.agents",
    "arclm.security",
    "arclm.peft",
    "arclm.search"
  ],
  "python_dependencies": ["torch>=2.1,<3", "numpy>=1.24,<3", "sentencepiece>=0.2,<0.3"],
  "optional_dependencies": {},
  "public_api": [
    "arclm.training",
    "arclm.models",
    "arclm.checkpoints",
    "arclm.tracking"
  ],
  "excluded_apis": ["arclm.finetuning", "arclm.web", "arclm.inference", "arclm.evaluation"],
  "commands": [
    "python -c \"from arclm.models import ArcLM; print(ArcLM)\"",
    "python -c \"from arclm.training import Trainer, TrainingConfig; print(Trainer)\""
  ],
  "tests": ["tests/unit/training", "tests/unit/test_light_imports.py"],
  "examples": ["examples/04_training/01_tiny_pretraining_step.py"],
  "documentation": ["README.md", "docs/distributions.md"],
  "license": "Apache-2.0"
}
