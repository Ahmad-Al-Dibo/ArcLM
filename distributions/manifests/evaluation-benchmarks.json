{
  "schema_version": 1,
  "id": "evaluation-benchmarks",
  "name": "ArcLM Evaluation Block",
  "description": "Metrics (accuracy, perplexity, loss), evaluation reports and training diagnostics. Requires PyTorch.",
  "source_package": "src/arclm",
  "capabilities": ["evaluation", "metrics", "diagnostics", "reports"],
  "include_modules": [
    "arclm._version",
    "arclm.evaluation",
    "arclm.training",
    "arclm.models",
    "arclm.inference",
    "arclm.checkpoints",
    "arclm.datasets",
    "arclm.tokenizers",
    "arclm.configs",
    "arclm.exceptions",
    "arclm.utils",
    "arclm.registry"
  ],
  "include_module_prefixes": [],
  "include_assets": ["arclm/py.typed"],
  "required_distributions": [],
  "excluded_module_prefixes": [
    "arclm.web",
    "arclm.finetuning",
    "arclm.agents",
    "arclm.security",
    "arclm.peft",
    "arclm.search"
  ],
  "python_dependencies": ["torch>=2.1,<3", "numpy>=1.24,<3", "sentencepiece>=0.2,<0.3"],
  "optional_dependencies": {},
  "public_api": ["arclm.evaluation", "arclm.inference", "arclm.models"],
  "excluded_apis": ["arclm.finetuning", "arclm.web", "arclm.agents"],
  "commands": [
    "python -c \"from arclm.evaluation import Evaluator, Accuracy, Perplexity; print(Evaluator)\""
  ],
  "tests": ["tests/unit/evaluation"],
  "examples": ["examples/07_evaluation_benchmarks/01_evaluation_metrics.py"],
  "documentation": ["README.md", "docs/distributions.md"],
  "license": "Apache-2.0"
}
