{
  "capabilities": [
    "training",
    "models",
    "datasets",
    "tokenizers",
    "checkpoints",
    "evaluation_hooks"
  ],
  "commands": [
    "python -c \"from arclm.training import TrainingConfig; print(TrainingConfig)\""
  ],
  "description": "Native model construction, training configuration, training loop, callbacks, metrics and checkpoints.",
  "documentation": [
    "README.md",
    "docs/distributions.md"
  ],
  "examples": [
    "examples/distributions/training_example.py"
  ],
  "excluded_apis": [
    "arclm.simple_interface",
    "arclm.web",
    "arclm.agents"
  ],
  "excluded_module_prefixes": [
    "arclm.web",
    "arclm.simple_interface",
    "arclm.simple_chat",
    "arclm.agents",
    "arclm.security.web"
  ],
  "id": "training",
  "include_assets": [
    "arclm/py.typed"
  ],
  "include_module_prefixes": [],
  "include_modules": [
    "arclm._version",
    "arclm.training",
    "arclm.models",
    "arclm.datasets",
    "arclm.tokenizers",
    "arclm.checkpoints",
    "arclm.configs",
    "arclm.evaluation",
    "arclm.lifecycle",
    "arclm.exceptions",
    "arclm.utils",
    "arclm.distributed",
    "arclm.tracking"
  ],
  "license": "Apache-2.0",
  "name": "ArcLM Training",
  "optional_dependencies": {},
  "public_api": [
    "arclm.training",
    "arclm.models",
    "arclm.checkpoints"
  ],
  "python_dependencies": [
    "torch>=2.1,<3",
    "numpy>=1.24,<3",
    "sentencepiece>=0.2,<0.3"
  ],
  "required_distributions": [
    "core",
    "data-tokenizers",
    "loading-inference"
  ],
  "schema_version": 1,
  "source_package": "src/arclm",
  "tests": [
    "tests/unit/training",
    "tests/checkpoints"
  ]
}